#!/usr/bin/env bash
# cadkit.engrave resolves its own font and points fontconfig at its own
# configuration, so this no longer sets either. It used to, and that was the
# reason parts only built through this wrapper -- see the 2026-09-27 commits.
set -euo pipefail
cd -- "$(dirname -- "$(readlink -f -- "$0")")"
exec .venv/bin/python "${@:-assembly.py}"
